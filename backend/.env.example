# Backend sample environment file (DO NOT commit real secrets)

# Server
PORT=5000
NODE_ENV=development

# Auth / JWT
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_ISSUER=maadin

# Base URLs (used to build absolute links, webhooks, etc.)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Database (if your app uses direct connections)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email (example)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASS=YOUR_SMTP_PASSWORD
EMAIL_FROM=no-reply@example.com

# Web Push
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY

# WhatsApp (example)
WHATSAPP_API_URL=https://api.example.com
WHATSAPP_TOKEN=YOUR_WHATSAPP_TOKEN
WHATSAPP_FROM=YOUR_WHATSAPP_FROM

# Zoom (example)
ZOOM_CLIENT_ID=YOUR_ZOOM_CLIENT_ID
ZOOM_CLIENT_SECRET=YOUR_ZOOM_CLIENT_SECRET
ZOOM_ACCOUNT_ID=YOUR_ZOOM_ACCOUNT_ID

# Payments: Stripe
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# Payments: Paystack
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY
PAYSTACK_WEBHOOK_SECRET=YOUR_PAYSTACK_WEBHOOK_SECRET

# Background jobs / cron toggles (optional)
REMINDERS_JOB_ENABLED=true

